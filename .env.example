# Used by docker-compose.yml. Copy to .env (never commit it).
# See apps/web/.env.example for all application variables.

# REQUIRED: random string, >= 32 chars (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# Public URL of the web app (OAuth callbacks and CLI upload links)
BETTER_AUTH_URL=http://localhost:3000
# Host port to publish
WEB_PORT=3000

# Optional GitHub OAuth app (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: GitHub token (no scopes) for GHSA queries; NVD key for CVSS enrichment
GITHUB_TOKEN=
NVD_API_KEY=

# Anonymous scan limits (defaults shown)
# VULNSTACK_MAX_UPLOAD_MB=10
# VULNSTACK_MAX_FILES=200
# VULNSTACK_SCANS_PER_MINUTE=10
# VULNSTACK_SCAN_TIMEOUT_MS=55000

# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
VULNSTACK_TRUST_PROXY=0

# DATABASE_URL and REDIS_URL are set by docker-compose.yml to the bundled services.
# To use external ones, edit the web service environment in docker-compose.yml.
