{
  "name": "vulnstack",
  "version": "0.1.0",
  "description": "Find known vulnerabilities (CVE / GHSA) in your project's dependencies",
  "license": "MIT",
  "author": "VulnStack contributors",
  "homepage": "https://github.com/vulnstack/vulnstack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulnstack/vulnstack.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/vulnstack/vulnstack/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "vulnstack": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "security",
    "cve",
    "vulnerability",
    "osv",
    "sca",
    "dependencies",
    "audit",
    "sarif",
    "ghsa",
    "github-action",
    "ci"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "@vulnstack/core": "workspace:*",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "tsup": "^9.0.0",
    "undici": "~7.30.0",
    "vitest": "^5.0.3"
  }
}
