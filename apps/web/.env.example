# Optional: GitHub token (no scopes) to also query the GitHub Advisory Database
GITHUB_TOKEN=
# Optional: NVD API key for CVSS enrichment (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
# Anonymous scan limits
VULNSTACK_MAX_UPLOAD_MB=10
# Max number of files accepted per upload
VULNSTACK_MAX_FILES=200
# Abort a scan that takes longer than this (milliseconds)
VULNSTACK_SCAN_TIMEOUT_MS=55000
VULNSTACK_SCANS_PER_MINUTE=10
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
VULNSTACK_TRUST_PROXY=0

# Accounts (optional). Without DATABASE_URL, local dev uses PGlite in .data/pglite
# Postgres connection string, e.g. postgres://user:pass@host:5432/vulnstack
DATABASE_URL=
# Random string (>= 32 chars) used to sign sessions and encrypt GitHub tokens
BETTER_AUTH_SECRET=
# Public URL of this app (OAuth callbacks and CLI upload links)
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth app credentials (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional shared advisory cache; falls back to Postgres/memory when unreachable
REDIS_URL=
