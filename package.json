{
  "name": "vulnstack-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "cli:link": "turbo run build --filter=vulnstack && cd apps/cli && pnpm link --global",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
