{
  "name": "@vulnstack/core",
  "version": "0.1.0",
  "description": "Framework-agnostic dependency vulnerability scanning engine for VulnStack",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "import": "./dist/meta.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@renovatebot/pep440": "^5.0.1",
    "cvss4": "^1.0.7",
    "fast-xml-parser": "^5.12.0",
    "p-limit": "^7.3.3",
    "semver": "^7.8.6",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/sarif": "^2.1.7",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0"
  }
}
