{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NEXT_TELEMETRY_DISABLED",
    "NO_PROXY",
    "TMPDIR",
    "XDG_CACHE_HOME",
    "http_proxy",
    "https_proxy",
    "no_proxy"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
